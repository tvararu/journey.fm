---
import Conversation from "@/app/album/Conversation.astro";
import Cover from "@/app/album/Cover.astro";
import InFiles from "@/app/album/InFiles.astro";
import Proposed from "@/app/album/Proposed.astro";
import Sources from "@/app/album/Sources.astro";
import Layout from "@/app/Layout.astro";
import { quality, size } from "@/lib/format";
import { album } from "@/lib/inventory";
import { rawFiles } from "@/lib/raw";
import { coverCandidates, coverChoices, notesFor, processed, redCopies } from "@/lib/records";
import { reviews, statusOf } from "@/lib/reviews";
import { agentState, verdicts } from "@/lib/verdicts";

const data = album(Number(Astro.params["id"]));
if (!data) return new Response("not found", { status: 404 });
const { album: a, files, tags, pictures, extras } = data;
const [done, covers, red, notes, allReviews, allVerdicts] = await Promise.all([
  processed(),
  coverChoices(),
  redCopies(),
  notesFor(a.path),
  reviews(),
  verdicts(),
]);
const rec = done.get(a.path);
const cover = rec ? covers[rec.slug] : undefined;
const candidates = rec ? await coverCandidates(rec.slug) : [];
const raw = rec ? await rawFiles(rec) : [];
const albumReviews = allReviews.get(a.path) ?? [];
const status = rec ? statusOf(rec, albumReviews) : null;
const albumVerdicts = allVerdicts.get(a.path) ?? [];
const agent = rec ? agentState(rec, albumVerdicts) : null;
const state = status ?? "triage";
const BADGE: Record<string, string> = { accepted: "badge-processed", triage: "" };
const embedded = pictures.find((p) => p.type === 3)?.sha256;
const folder = extras.find((x) => /\.(jpe?g|png)$/i.test(x.relpath))?.sha256;
const fallback = embedded ?? folder;
const here = Astro.url.pathname;
const totalBytes = files.reduce((s, f) => s + f.size, 0) + extras.reduce((s, x) => s + x.size, 0);
const minutes = Math.round(files.reduce((s, f) => s + (f.duration ?? 0), 0) / 60);
---
<Layout title={`${a.album_dir} - journey.fm`}>
  <p><a id="back" href="/">← Library</a></p>
  <header class="mt-4">
    <h1>{a.album_dir}</h1>
    <p class="text-muted">{a.artist_dir}</p>
    <p class="mt-2">
      <span class={`badge ${BADGE[state] ?? "chg border-transparent"}`}>{state}</span>
      {agent && (
        <span class={`badge ml-1 border-transparent ${agent.stale ? "text-muted" : agent.verdict === "approve" ? "new" : "badge-issue"}`}>
          {agent.stale ? "agent verdict stale" : agent.verdict === "approve" ? "agent approved" : "agent flagged"}
        </span>
      )}
    </p>
    {agent?.verdict === "flag" && !agent.stale && <p class="mt-2 max-w-3xl border-l-2 border-chg-fg pl-3 text-chg-fg">{agent.message}</p>}
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 text-sm">
      <dt class="text-muted">Audio</dt><dd>{quality(files)}</dd>
      <dt class="text-muted">Size</dt><dd>{size(totalBytes)} · {files.length} tracks · {minutes} min</dd>
      <dt class="text-muted">On sol</dt><dd class="break-all">{a.path}</dd>
      {rec && Object.keys(rec.album.ratings).length > 0 && (
        <>
          <dt class="text-muted">Ratings</dt>
          <dd>{Object.entries(rec.album.ratings).map(([s, r]) => `${s} ${r.value.toFixed(2)} (${r.count.toLocaleString("en-GB")})`).join(" · ")}</dd>
        </>
      )}
      {rec && rec.album.links.length > 0 && (
        <>
          <dt class="text-muted">Links</dt>
          <dd class="flex flex-wrap gap-x-3">{rec.album.links.map((l) => <a href={l.url}>{l.label}</a>)}</dd>
        </>
      )}
      <dt class="text-muted">RED</dt><dd class="break-all">{(red[a.path] ?? []).join(", ") || "none"}</dd>
    </dl>
  </header>

  <Cover cover={cover} candidates={candidates} fallback={fallback ? `/blob/${fallback}` : null} slug={rec?.slug} album={a.path} back={here} />
  {rec && <Proposed rec={rec} tags={tags} />}
  <Conversation notes={notes} reviews={albumReviews} verdicts={albumVerdicts} album={a.path} back={here} status={status} />

  {rec && (
    <details>
      <summary>Sources</summary>
      <Sources rec={rec} raw={raw} />
    </details>
  )}
  <details>
    <summary>Files on disk</summary>
    <InFiles files={files} tags={tags} pictures={pictures} extras={extras} />
  </details>
</Layout>

<script>
  const back = document.querySelector<HTMLAnchorElement>("#back");
  let list: string | null = null;
  try {
    list = sessionStorage.getItem("list");
  } catch {}
  const field = document.querySelector<HTMLInputElement>("input[name=list]");
  if (field && list?.startsWith("/")) field.value = list;
  if (back && list?.startsWith("/")) back.href = list;
  const from = document.referrer ? new URL(document.referrer) : null;
  if (back && from?.origin === location.origin && from.pathname === "/") {
    back.href = from.pathname + from.search;
    back.addEventListener("click", (e) => {
      e.preventDefault();
      history.back();
    });
  }
</script>
