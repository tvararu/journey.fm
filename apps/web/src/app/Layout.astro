---
import "./styles.css";

type Props = { title: string };
const { title } = Astro.props;
const flash = Astro.cookies.get("flash")?.value;
if (flash) Astro.cookies.delete("flash", { path: "/" });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/iosevka-nfp-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-gap font-mono text-fg">
    {flash && <div class="flash fixed top-4 right-4 z-50 border border-new-fg bg-new px-4 py-2 text-sm text-new-fg">{flash}</div>}
    <main class="mx-auto max-w-[1400px] px-4 pt-6 pb-16">
      <slot />
    </main>
  </body>
</html>
