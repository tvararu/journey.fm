---
import { show } from "@/lib/format";
import type { RymLink, Value } from "@/lib/records";

type Props = { value: Value | undefined; chips?: boolean; chip?: "chip" | "chip-2" | "chip-scene"; links?: Map<string, RymLink> };
const { value, chips = false, chip = "chip-2", links } = Astro.props;
const list = Array.isArray(value) ? value : [value];
const url = typeof value === "string" && value.startsWith("https://") ? value : null;
const none = show(value) === "-";
---
{chips && !none ? (
  <div class="flex flex-wrap">
    {list.map((v) => {
      const link = links?.get(String(v));
      return link ? (
        <a class={chip} href={link.url} title={`RYM genre ${link.id}`}>{v}</a>
      ) : (
        <span class={chip}>{v}</span>
      );
    })}
  </div>
) : url ? (
  <a class="hover:underline" href={url}>{url.replace(/\/$/, "").split("/").at(-1)}</a>
) : none ? (
  <span class="text-muted">—</span>
) : (
  <span>{show(value)}</span>
)}
