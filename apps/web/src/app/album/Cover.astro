---
import { frontLabels, fronts as frontsOf, groups as coverGroups, upscaledBy } from "@/lib/covers";
import { thumbUrl } from "@/lib/library";
import type { CoverCandidate, CoverChoice } from "@/lib/records";
import { UPSCALERS } from "@/lib/upscale";

type Props = {
  cover: CoverChoice | undefined;
  candidates: CoverCandidate[];
  fallback: string | null;
  slug: string | undefined;
  album: string;
  back: string;
};
const { cover, candidates, fallback, slug, album, back } = Astro.props;
const fronts = frontsOf(candidates);
const others = candidates.length - fronts.length;
const labels = frontLabels(candidates);
const groups = coverGroups(candidates);
const kb = (n: number) => `${Math.floor(n / 1024)} KB`;
const facts = cover
  ? [
      ["file", "cover.jpg"],
      ["size", `${cover.chosen.width}×${cover.chosen.height} · ${kb(cover.master_bytes)}`],
      ["from", cover.chosen.source],
      ["encode", cover.master_method],
      ["embedded", `${cover.embed_size[0]}×${cover.embed_size[1]} · ${kb(cover.embed_bytes)}`],
    ]
  : [];
---
<div class="flex flex-wrap items-start gap-7">
  <div class="flex min-w-0 flex-col gap-3 lg:flex-[0_0_300px] max-lg:w-full">
    {cover ? (
      <>
        <a href={`/data/${cover.master}`} class="relative block aspect-square w-full max-w-[300px] bg-dark max-lg:mx-auto">
          <img class="size-full object-cover" src={thumbUrl(cover.master)} alt="" />
          <span class="absolute top-2 left-2 bg-fg px-1.5 py-px font-extrabold text-bg">MASTER</span>
        </a>
        <div class="flex flex-col gap-[3px]">
          {facts.map(([k, v]) => <div class="leader"><span class="shrink-0 text-muted">{k}</span><i></i><span>{v}</span></div>)}
        </div>
        <div class="flex items-center gap-3 pt-1">
          <a href={`/data/${cover.embed}`} class="block size-[72px] shrink-0 bg-dark"><img class="size-full object-cover" src={thumbUrl(cover.embed)} alt="" /></a>
          <span class="flex min-w-0 flex-col gap-0.5">
            <b class="font-bold">embedded copy</b>
            <span class="text-muted">{cover.embed_size[0]}×{cover.embed_size[1]} · {kb(cover.embed_bytes)}</span>
          </span>
        </div>
      </>
    ) : (
      <>
        {fallback ? <img class="aspect-square w-full max-w-[300px] bg-dark object-cover max-lg:mx-auto" src={fallback} alt="" /> : <div class="aspect-square w-full max-w-[300px] bg-dark"></div>}
        <span class="text-muted">no master yet</span>
      </>
    )}
  </div>
  {fronts.length > 0 && (
    <div class="flex min-w-0 flex-col gap-3 lg:flex-[1_1_360px] max-lg:w-full">
      <div class="rule-head"><span>──</span><b class="font-extrabold text-fg">front candidates · {fronts.length}</b><span class="max-lg:hidden">pick by eye: edition held, clean scan, then size</span><i class="h-px flex-1 bg-faint"></i></div>
      <div class="grid grid-cols-3 gap-x-3 gap-y-4 max-lg:grid-cols-2">
        {groups.flatMap((g) => [...(g.lead ? [g.lead] : []), ...g.kids]).map((c) => {
          const label = labels.get(c.id) ?? c.id;
          return (
            <div class="group/c flex min-w-0 flex-col gap-1.5">
              <a href={`/data/${c.path}`} class="flex aspect-square w-full items-center justify-center overflow-hidden border-2 border-transparent bg-dark group-has-checked/c:border-active">
                <img class="size-full object-contain" loading="lazy" src={thumbUrl(c.path)} alt="" />
              </a>
              <span class="flex flex-col gap-px text-[11px]">
                <b class="text-xs font-bold">{label}</b>
                <span class="text-muted">{c.width}×{c.height} · {kb(c.bytes)}</span>
                {c.note && <span class="text-muted">{c.note}</span>}
              </span>
              {slug && (
                <span class="flex flex-wrap gap-1">
                  <label class="btn-2 h-[22px] cursor-pointer text-[11px] max-lg:h-11 has-checked:border-transparent has-checked:bg-fg has-checked:font-extrabold has-checked:text-bg">
                    <input type="radio" name="cover" form="review" value={c.id} data-label={`${label} · ${c.width}×${c.height}`} checked={c.id === cover?.chosen.id} class="peer sr-only" />
                    <span class="peer-checked:hidden">○ use as master</span><span class="hidden peer-checked:inline">● master</span>
                  </label>
                  {!upscaledBy(c) && (
                    <details class="relative">
                      <summary class="btn-2 h-[22px] cursor-pointer list-none text-[11px] max-lg:h-11">upscale ▾</summary>
                      <form method="post" action="/api/upscale" class="upscale box absolute top-full left-0 z-10 mt-1 w-max bg-bg">
                        <input type="hidden" name="slug" value={slug} />
                        <input type="hidden" name="album" value={album} />
                        <input type="hidden" name="back" value={back} />
                        <input type="hidden" name="candidate" value={c.id} />
                        {Object.entries(UPSCALERS).map(([k, u]) => <button name="upscaler" value={k} class="btn-2 h-[22px] text-[11px] max-lg:h-11">{u.label}</button>)}
                      </form>
                    </details>
                  )}
                </span>
              )}
            </div>
          );
        })}
      </div>
      {others > 0 && <span class="text-[11px] text-muted">{others} more images archived</span>}
    </div>
  )}
</div>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("form.upscale")) {
    form.addEventListener("submit", () => {
      const summary = form.parentElement?.querySelector("summary");
      if (summary) summary.textContent = "upscaling…";
      setTimeout(() => {
        for (const b of form.querySelectorAll("button")) b.disabled = true;
      });
    });
  }
</script>
