#!/usr/bin/env bash
#MISE description="Back up raw responses, the catalogue and design boards to sol's music-meta (adds and updates, never deletes)"
set -euo pipefail

data="$MISE_PROJECT_ROOT/data"
for dir in raw catalogue catalogue-removed design; do
  [ -d "$data/$dir" ] || continue
  rsync -au "$data/$dir" sol:/mnt/pool/music-meta/
  echo "pushed $dir/ to sol"
done
