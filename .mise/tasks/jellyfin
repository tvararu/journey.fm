#!/usr/bin/env bash
#MISE description="Jellyfin: refresh (replace all metadata from the tags, then the album artists) | clear (online leftovers on albums) | test (the plugin's tests)"
set -euo pipefail
root="$MISE_PROJECT_ROOT"
case "${1:-}" in
test)
  shift
  exec dotnet test "$root/apps/jellyfin/Jellyfin.Plugin.Journey.Tests" "$@"
  ;;
*)
  cd "$root/packages/catalogue"
  exec bun jellyfin.ts "$@"
  ;;
esac
