---
import { ALBUM_KEYS, summarise, type Tag } from "@/lib/album";
import { blocks, clock } from "@/lib/format";
import type { ExtraRow, FileRow, PictureRow } from "@/lib/inventory";

type Props = { files: FileRow[]; tags: Map<number, Tag[]>; pictures: PictureRow[]; extras: ExtraRow[] };
const { files, tags, pictures, extras } = Astro.props;
const summary = summarise(tags);
const embedded = new Map<string, { p: PictureRow; n: number }>();
for (const p of pictures) {
  const e = embedded.get(p.sha256) ?? { n: 0, p };
  e.n++;
  embedded.set(p.sha256, e);
}
const IMAGE = /\.(jpe?g|png)$/i;
const images = extras.filter((x) => IMAGE.test(x.relpath));
const others = extras.filter((x) => !IMAGE.test(x.relpath));
const cut = (v: string) => (v.length > 300 ? `${v.slice(0, 300)}…` : v);
---
<h3>Album tags</h3>
<div class="card">
  <table class="grid-table">
    <thead><tr><th>Key</th><th>Values</th><th>Tracks</th></tr></thead>
    <tbody>
      {summary.map((s) => (
        <tr>
          <th>{s.key}</th>
          <td class={s.values.length > 1 && ALBUM_KEYS.has(s.key.toUpperCase()) ? "chg" : ""}>
            {s.values.slice(0, 12).map(([v, n]) => (
              <div>{cut(v)}{s.values.length > 1 && <span class="text-muted"> ×{n}</span>}</div>
            ))}
            {s.values.length > 12 && <div class="text-muted">and {s.values.length - 12} more</div>}
          </td>
          <td>{s.count}/{files.length}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<h3>Files</h3>
<div class="card">
  <table class="grid-table">
    <thead><tr><th>File</th><th>Format</th><th>Length</th><th>Size</th><th>Audio MD5</th><th>Encoder</th><th>Blocks</th></tr></thead>
    <tbody>
      {files.map((f) => (
        <tr>
          <td class="whitespace-nowrap">{f.relpath}{(f.id3v2 || f.id3v1) ? <span class="badge badge-issue ml-1">ID3</span> : null}</td>
          <td class="whitespace-nowrap">{f.codec} {f.bits}/{f.sample_rate} {f.channels}ch</td>
          <td>{clock(f.duration ?? 0)}</td>
          <td class="whitespace-nowrap">{(f.size / 1e6).toFixed(1)} MB</td>
          <td class="text-xs">{f.audio_md5}</td>
          <td class="text-xs">{f.vendor}</td>
          <td class="text-xs text-muted">{blocks(f.blocks)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<details class="mt-4">
  <summary>Every tag, track by track</summary>
  {files.map((f) => (
    <>
      <h4>{f.relpath}</h4>
      <div class="card">
        <table class="grid-table">
          <tbody>
            {(tags.get(f.id) ?? []).map((t) => <tr><th>{t.key}</th><td>{t.value}</td></tr>)}
          </tbody>
        </table>
      </div>
    </>
  ))}
</details>

<h3>Pictures</h3>
<div class="flex flex-wrap gap-4">
  {[...embedded.entries()].map(([h, { p, n }]) => (
    <figure class="w-32">
      <img class="size-32 bg-faint object-cover" src={`/blob/${h}`} alt="" />
      <figcaption class="text-xs text-muted">embedded ×{n}<br />type {p.type} {p.width}x{p.height}<br />{Math.floor(p.size / 1024)} KB</figcaption>
    </figure>
  ))}
  {images.map((x) => (
    <figure class="w-32">
      <img class="size-32 bg-faint object-cover" src={`/blob/${x.sha256}`} alt="" />
      <figcaption class="text-xs text-muted">{x.relpath}<br />{Math.floor(x.size / 1024)} KB</figcaption>
    </figure>
  ))}
</div>
{others.length > 0 && (
  <>
    <h3>Other files</h3>
    <ul>{others.map((x) => <li>{x.relpath} ({x.size} B)</li>)}</ul>
  </>
)}
