#!/usr/bin/env bash
#MISE description="Jellyfin: refresh (replace all metadata from the tags, then the album artists) | clear (online leftovers on albums) | options (prefer ARTISTS) | test (the plugin's tests) | plugin (build and install the plugin on sol)"
set -euo pipefail
root="$MISE_PROJECT_ROOT"
case "${1:-}" in
test)
  shift
  exec dotnet test "$root/apps/jellyfin/Jellyfin.Plugin.Journey.Tests" "$@"
  ;;
plugin)
  out="$root/apps/jellyfin/build"
  rm -rf "$out"
  dotnet publish "$root/apps/jellyfin/Jellyfin.Plugin.Journey" -c Release -o "$out"
  version=$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' "$root/apps/jellyfin/Jellyfin.Plugin.Journey/Jellyfin.Plugin.Journey.csproj")
  stage=/tmp/journey-plugin
  cat > "$out/meta.json" <<EOF
{
  "category": "Metadata",
  "changelog": "",
  "description": "Maps the catalogue's tags into Jellyfin's fields.",
  "guid": "5f0c4a7e-3b9d-4c21-8e6a-9d2b7f1c4e83",
  "name": "journey.fm",
  "overview": "Maps the catalogue's tags into Jellyfin's fields.",
  "owner": "deity",
  "targetAbi": "12.4.0.0",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "version": "$version",
  "status": "Active",
  "autoUpdate": false,
  "assemblies": []
}
EOF
  ssh sol bash -c "'rm -rf $stage && mkdir -p $stage/Journey_$version'"
  scp -q "$out/Jellyfin.Plugin.Journey.dll" "$out/meta.json" "sol:$stage/Journey_$version/"
  ssh sol bash -c "'docker exec jellyfin sh -c \"rm -rf /config/plugins/Journey_*\" && docker cp $stage/Journey_$version jellyfin:/config/plugins/ && rm -rf $stage && docker restart jellyfin'"
  ;;
*)
  cd "$root/packages/catalogue"
  exec bun jellyfin.ts "$@"
  ;;
esac
