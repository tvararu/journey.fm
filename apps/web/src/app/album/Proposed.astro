---
import { CHIP_FIELDS, change, FIELD_NAMES, FIELD_TAGS, type Tag, valuesFor } from "@/lib/album";
import { empty, show } from "@/lib/format";
import type { AlbumRecord, Field, RymLink, Value } from "@/lib/records";
import Tracks from "./Tracks.astro";
import ValueView from "./Value.astro";

type Props = { rec: AlbumRecord; tags: Map<number, Tag[]> };
const { rec, tags } = Astro.props;
const rl = rec.album.rym_links;
const links = new Map<string, RymLink>(
  [...(rl?.primary ?? []), ...(rl?.secondary ?? []), ...(rl?.scenes ?? [])].map((g) => [g.name, g]),
);
const fields = Object.entries(rec.album).filter(([k]) => !["ids", "rym_links", "cover", "ratings"].includes(k)) as [string, Field][];
const had = (k: string): Value => {
  const keys = FIELD_TAGS[k];
  return keys ? valuesFor(tags, keys) : null;
};
const proposed = (k: string, f: Field): Value => (k === "scene" && typeof f.value === "string" ? [f.value] : f.value);
const ids = Object.entries(rec.album.ids).filter(([, v]) => v !== null && !(Array.isArray(v) && v.length === 0));
const STATUS = { "": "same", chg: "changed", new: "new" } as const;
---
<h2>Tags</h2>
<div class="card">
  <table class="grid-table">
    <thead><tr><th>Field</th><th>Proposed</th><th>From</th><th>Files have</th></tr></thead>
    <tbody>
      {fields.map(([k, f]) => {
        const cls = change(had(k), f.value);
        return (
          <tr>
            <th>{FIELD_NAMES[k] ?? k}</th>
            <td class={cls}><ValueView value={proposed(k, f)} chips={CHIP_FIELDS.has(k)} links={links} /></td>
            <td class="text-xs whitespace-nowrap text-muted">{f.source}</td>
            <td class="text-xs">
              {cls === "chg" ? <span>{show(had(k))}</span> : <span class="text-muted">{empty(f.value) ? "" : STATUS[cls]}</span>}
            </td>
          </tr>
        );
      })}
      <tr>
        <th>IDs</th>
        <td colspan="3" class="text-xs">{ids.map(([k, v]) => <div>{k}: <ValueView value={v} /></div>)}</td>
      </tr>
    </tbody>
  </table>
</div>

<Tracks rec={rec} />
