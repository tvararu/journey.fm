---
import { alternatives, CHIP_FIELDS, change, FIELD_NAMES, FIELD_TAGS, type Tag, valuesFor } from "@/lib/album";
import type { AlbumRecord, Field, RymLink, Value } from "@/lib/records";
import Value from "./Value.astro";

type Props = { rec: AlbumRecord; tags: Map<number, Tag[]> };
const { rec, tags } = Astro.props;
const rl = rec.album.rym_links;
const links = new Map<string, RymLink>(
  [...(rl?.primary ?? []), ...(rl?.secondary ?? []), ...(rl?.scenes ?? [])].map((g) => [g.name, g]),
);
const fields = Object.entries(rec.album).filter(([k]) => k !== "ids" && k !== "rym_links") as [string, Field][];

function now(k: string, f: Field): Value {
  if (k === "cover") return f.candidates["files"] ?? null;
  const keys = FIELD_TAGS[k];
  return keys ? valuesFor(tags, keys) : null;
}

function proposed(k: string, f: Field): Value {
  return k === "scene" && typeof f.value === "string" ? [f.value] : f.value;
}

const ids = Object.entries(rec.album.ids).filter(([, v]) => v !== null && !(Array.isArray(v) && v.length === 0));
---
<h2>Album</h2>
<div class="mb-2 flex gap-4 text-xs text-muted">
  <span><i class="mr-1 inline-block size-3 bg-chg align-[-1px]"></i>Changes what the files say</span>
  <span><i class="mr-1 inline-block size-3 bg-new align-[-1px]"></i>New, the files have nothing</span>
</div>
<div class="card">
  <table class="grid-table">
    <thead><tr><th>Field</th><th>Files now</th><th>Proposed</th><th>Other sources</th></tr></thead>
    <tbody>
      {fields.map(([k, f]) => (
        <tr>
          <th>{FIELD_NAMES[k] ?? k}</th>
          <td><Value value={now(k, f)} /></td>
          <td class={k === "cover" ? "" : change(now(k, f), f.value)}>
            <Value value={proposed(k, f)} chips={CHIP_FIELDS.has(k)} links={links} />
            <span class="src">{f.source}</span>
          </td>
          <td>
            {alternatives(f).map(([s, v]) => (
              <div class="text-xs"><b class="text-muted">{s}</b> <Value value={v} /></div>
            ))}
          </td>
        </tr>
      ))}
      <tr>
        <th>IDs</th>
        <td><Value value={valuesFor(tags, ["MUSICBRAINZ_ALBUMID", "MUSICBRAINZ ALBUM ID"])} /></td>
        <td colspan="2" class="text-xs">
          {ids.map(([k, v]) => (
            <div>{k}: <Value value={v} /></div>
          ))}
        </td>
      </tr>
    </tbody>
  </table>
</div>
