---
import { ALBUM_KEYS, summarise, type Tag } from "@/lib/album";
import { audio, blocks, clock } from "@/lib/format";
import type { ExtraRow, FileRow, PictureRow } from "@/lib/inventory";

type Props = { files: FileRow[]; tags: Map<number, Tag[]>; pictures: PictureRow[]; extras: ExtraRow[] };
const { files, tags, pictures, extras } = Astro.props;
const summary = summarise(tags);
const embedded = new Map<string, { p: PictureRow; n: number }>();
for (const p of pictures) {
  const e = embedded.get(p.sha256) ?? { n: 0, p };
  e.n++;
  embedded.set(p.sha256, e);
}
const IMAGE = /\.(jpe?g|png)$/i;
const images = extras.filter((x) => IMAGE.test(x.relpath));
const others = extras.filter((x) => !IMAGE.test(x.relpath));
const cut = (v: string) => (v.length > 300 ? `${v.slice(0, 300)}…` : v);
const differs = (s: (typeof summary)[number]) => s.values.length > 1 && ALBUM_KEYS.has(s.key.toUpperCase());
const keysDiffer = summary.filter(differs).length;
const codecs = [...new Set(files.map((f) => f.codec.toUpperCase()))].join(", ");
const formats = [...new Set(files.map((f) => audio(String(f.bits), String(f.sample_rate))))];
const COLS = "grid-cols-[minmax(0,1.4fr)_92px_64px_72px_minmax(0,1.2fr)_minmax(0,1.6fr)]";
---
<div class="flex flex-col">
  <div class="max-lg:overflow-x-auto">
    <div class="max-lg:min-w-[760px]">
      <div class={`grid ${COLS} h-[26px] items-center gap-3 border-b border-faint px-2.5 text-[11px] text-muted`}>
        <span>file</span><span>audio</span><span class="text-right">length</span><span class="text-right">size</span><span>audio md5</span><span>blocks</span>
      </div>
      {files.map((f) => (
        <div class={`grid ${COLS} min-h-7 items-center gap-3 border-b border-f8 px-2.5 py-0.5 whitespace-nowrap`}>
          <span class="flex min-w-0 items-center gap-1.5"><span class="truncate">{f.relpath}</span>{(f.id3v2 || f.id3v1) && <span class="px-1 text-[11px] font-bold text-danger">ID3</span>}</span>
          <span class="text-muted">{audio(String(f.bits), String(f.sample_rate))} {f.channels}ch</span>
          <span class="text-right">{clock(f.duration ?? 0)}</span>
          <span class="text-right text-fg2">{(f.size / 1e6).toFixed(1)} MB</span>
          <span class="truncate text-[11px] text-muted">{f.audio_md5}</span>
          <span class="truncate text-[11px] text-muted">{blocks(f.blocks)}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="flex flex-wrap gap-x-[18px] px-2.5 pt-3 text-[11px] text-muted">
    <span>{files.length} {codecs} · {formats.join(", ")} · {pictures.length} embedded pictures · {keysDiffer} album keys differ</span>
  </div>

  <div class="rule-head mt-[22px]"><span>──</span><b class="font-extrabold text-fg">album tags</b><span>{summary.length} keys</span><i class="h-px flex-1 bg-faint"></i></div>
  <div class="px-2.5 pt-2">
    {summary.map((s) => (
      <div class="grid grid-cols-[150px_minmax(0,1fr)_56px] gap-3 border-b border-f8 py-[3px] max-lg:grid-cols-[110px_minmax(0,1fr)_48px]">
        <span class="truncate text-fg2">{s.key}</span>
        <span class={`min-w-0 break-words ${differs(s) ? "text-danger" : ""}`}>
          {s.values.slice(0, 12).map(([v, n]) => <div>{cut(v)}{s.values.length > 1 && <span class="text-muted"> ×{n}</span>}</div>)}
          {s.values.length > 12 && <div class="text-muted">and {s.values.length - 12} more</div>}
        </span>
        <span class="text-right text-muted">{s.count}/{files.length}</span>
      </div>
    ))}
  </div>

  <details class="mt-[22px]">
    <summary class="rule-head cursor-pointer list-none"><span>──</span><b class="font-extrabold text-fg">every tag, track by track</b><span>{files.length} files</span><i class="h-px flex-1 bg-faint"></i></summary>
    {files.map((f) => (
      <div class="px-2.5 pt-3">
        <div class="font-bold">{f.relpath}</div>
        {(tags.get(f.id) ?? []).map((t) => (
          <div class="grid grid-cols-[150px_minmax(0,1fr)] gap-3 border-b border-f8 py-[2px] text-[11px] max-lg:grid-cols-[110px_minmax(0,1fr)]">
            <span class="truncate text-muted">{t.key}</span><span class="min-w-0 break-words">{t.value}</span>
          </div>
        ))}
      </div>
    ))}
  </details>

  <div class="rule-head mt-[22px]"><span>──</span><b class="font-extrabold text-fg">pictures</b><span>{embedded.size + images.length}</span><i class="h-px flex-1 bg-faint"></i></div>
  <div class="flex flex-wrap gap-4 px-2.5 pt-2.5">
    {[...embedded.entries()].map(([h, { p, n }]) => (
      <figure class="w-32">
        <img class="size-32 bg-dark object-cover" loading="lazy" src={`/thumb/blob/${h}`} alt="" />
        <figcaption class="text-[11px] text-muted">embedded ×{n}<br />type {p.type} · {p.width}×{p.height}<br />{Math.floor(p.size / 1024)} KB</figcaption>
      </figure>
    ))}
    {images.map((x) => (
      <figure class="w-32">
        <img class="size-32 bg-dark object-cover" loading="lazy" src={`/thumb/blob/${x.sha256}`} alt="" />
        <figcaption class="truncate text-[11px] text-muted">{x.relpath}<br />{Math.floor(x.size / 1024)} KB</figcaption>
      </figure>
    ))}
  </div>
  {others.length > 0 && (
    <>
      <div class="rule-head mt-[22px]"><span>──</span><b class="font-extrabold text-fg">other files</b><span>{others.length}</span><i class="h-px flex-1 bg-faint"></i></div>
      <ul class="px-2.5 pt-2 text-[11px] text-fg2">{others.map((x) => <li>{x.relpath} <span class="text-muted">({x.size} B)</span></li>)}</ul>
    </>
  )}
</div>
