---
import type { Note } from "@/lib/records";

type Props = { notes: Note[] };
const { notes } = Astro.props;
---
<h2>Notes</h2>
{notes.length === 0 ? (
  <p class="text-muted">None yet. Add one with <code>mise music:note</code>.</p>
) : (
  <ol class="space-y-3">
    {notes.map((n) => (
      <li class="border-l-2 border-rule pl-3">
        <div class="text-xs text-muted">{n.at} · {n.by}</div>
        <p>{n.text}</p>
      </li>
    ))}
  </ol>
)}
