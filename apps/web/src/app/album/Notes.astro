---
import type { Note } from "@/lib/records";

type Props = { notes: Note[]; album: string; back: string };
const { notes, album, back } = Astro.props;
---
<form method="post" action="/api/notes" class="mb-6 flex flex-col gap-2 border border-rule bg-bg p-3">
  <input type="hidden" name="album" value={album} />
  <input type="hidden" name="back" value={back} />
  <textarea
    name="text"
    required
    rows="3"
    class="w-full border border-rule bg-gap p-2"
    placeholder="Leave a note, or an instruction for the next agent working on this album"
  ></textarea>
  <div class="flex flex-wrap items-center gap-4 text-sm">
    <label><input type="radio" name="kind" value="note" checked /> Note</label>
    <label><input type="radio" name="kind" value="instruction" /> Instruction for an agent</label>
    <button class="ml-auto border border-accent bg-accent px-3 py-1 text-bg">Save as deity</button>
  </div>
</form>
{notes.length === 0 ? (
  <p class="text-muted">No notes yet.</p>
) : (
  <ol class="space-y-3">
    {notes.map((n) => (
      <li class={`border-l-2 pl-3 ${n.kind === "instruction" ? "border-chg-fg" : "border-rule"}`}>
        <div class="text-xs text-muted">
          {n.at} · {n.by}
          {n.kind === "instruction" && <span class="badge chg ml-1 border-transparent">instruction</span>}
        </div>
        <p class="whitespace-pre-line">{n.text}</p>
      </li>
    ))}
  </ol>
)}
