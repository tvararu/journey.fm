---
import type { ApprovalState } from "@/lib/approvals";

type Props = { state: ApprovalState; album: string; back: string };
const { state, album, back } = Astro.props;
const approved = state.status === "approved";
---
<form method="post" action="/api/approve" class={`mb-6 flex flex-wrap items-center gap-4 border p-3 ${approved ? "border-new-fg bg-new text-new-fg" : state.status === "stale" ? "border-chg-fg bg-chg text-chg-fg" : "border-rule bg-bg"}`}>
  <input type="hidden" name="album" value={album} />
  <input type="hidden" name="back" value={back} />
  <input type="hidden" name="action" value={approved ? "revoke" : "approve"} />
  <div class="text-sm">
    {approved && <>Approved {state.last?.at} by {state.last?.by}. Ready to write into the FLACs.</>}
    {state.status === "stale" && <>Approved {state.last?.at}, but the proposal has changed since. Review and approve again.</>}
    {state.status === "none" && <>Not approved. Approve when every field below is what you want written into the files.</>}
  </div>
  <button class={`ml-auto border px-3 py-1 ${approved ? "border-rule bg-bg text-fg" : "border-accent bg-accent text-bg"}`}>
    {approved ? "Revoke approval" : "Approve for writing"}
  </button>
</form>
