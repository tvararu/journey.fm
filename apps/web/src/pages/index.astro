---
import Layout from "@/app/Layout.astro";
import { format, size } from "@/lib/format";
import { library } from "@/lib/library";

const rows = await library();
const FILTERS = ["all", "triage", "ready", "investigate", "review", "changes", "accepted", "issues"];
const GROUP: Record<string, string> = {
  "accepted, then changed": "review",
  "awaiting review": "review",
  "changes requested": "changes",
  "updated since request": "review",
};
const BADGE: Record<string, string> = { accepted: "badge-processed", triage: "" };
const LABELS: Record<string, string> = {
  changes: "changes requested", investigate: "to investigate", issues: "with issues", ready: "ready for you", review: "to review",
};
const bucket = (r: (typeof rows)[number]): string => {
  const g = GROUP[r.state] ?? r.state;
  if (g !== "review" || !r.agent || r.agent.stale) return g;
  return r.agent.verdict === "approve" ? "ready" : "investigate";
};
const initialFilter = FILTERS.find((f) => f === Astro.url.searchParams.get("f")) ?? "all";
const initialQuery = Astro.url.searchParams.get("q") ?? "";
const count = (s: string) => rows.filter((r) => r.state === s).length;
const tally = (f: string): number =>
  f === "all" ? rows.length : f === "issues" ? rows.filter((r) => r.issues.length).length : rows.filter((r) => bucket(r) === f).length;
const totalBytes = rows.reduce((s, r) => s + r.bytes, 0);
---
<Layout title="journey.fm">
  <h1 class="text-2xl font-bold">journey.fm</h1>
  <p class="mt-1 text-muted">
    {rows.length} albums in sol's Music ({size(totalBytes)}), scanned 29 Oct. {count("triage")} in triage,
    {count("awaiting review") + count("updated since request") + count("accepted, then changed")} to review,
    {rows.filter((r) => bucket(r) === "ready").length} of them ready for you, {rows.filter((r) => bucket(r) === "investigate").length} to investigate,
    {count("changes requested")} with changes requested, {count("accepted")} accepted. Nothing written yet.
  </p>
  <div class="my-4 flex flex-wrap items-center gap-2">
    <input
      id="q"
      autofocus
      value={initialQuery}
      class="min-w-64 border border-rule bg-bg px-3 py-1.5"
      placeholder="Filter by artist, album or issue"
    />
    {FILTERS.map((f) => (
      <button
        data-f={f}
        aria-pressed={f === initialFilter ? "true" : "false"}
        class="border border-rule bg-bg px-3 py-1 capitalize aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-bg"
      >
        {LABELS[f] ?? f} <span class="opacity-70">{tally(f)}</span>
      </button>
    ))}
    <span id="n" class="text-muted"></span>
  </div>
  <div class="card">
    <table class="grid-table">
      <thead>
        <tr><th></th><th>Album</th><th>State</th><th>Date tag</th><th>Audio</th><th>Size</th><th>Tracks</th><th>Length</th><th>Issues</th></tr>
      </thead>
      <tbody id="rows">
        {rows.map((r) => (
          <tr
            data-state={bucket(r)}
            data-issues={r.issues.length}
            data-q={`${r.path} ${r.issues.join(" ")} ${r.agent?.message ?? ""}`.toLowerCase()}
          >
            <td>
              {r.thumb ? (
                <img class="size-10 bg-faint object-cover" loading="lazy" src={`/blob/${r.thumb}`} alt="" />
              ) : (
                <div class="size-10 bg-faint" />
              )}
            </td>
            <td>
              <a href={`/album/${r.id}`}>{r.album_dir}</a>
              <span class="src">{r.artist_dir}</span>
            </td>
            <td>
              <span class={`badge whitespace-nowrap ${BADGE[r.state] ?? "chg border-transparent"}`}>{r.state}</span>
              {r.agent && (bucket(r) === "ready" || bucket(r) === "investigate" || r.agent.stale) && (
                <span class={`badge ml-1 whitespace-nowrap border-transparent ${r.agent.stale ? "text-muted" : r.agent.verdict === "approve" ? "new" : "badge-issue"}`}>
                  {r.agent.stale ? "agent verdict stale" : r.agent.verdict === "approve" ? "agent approved" : "agent flagged"}
                </span>
              )}
            </td>
            <td class="whitespace-nowrap">{r.dates.join(", ")}</td>
            <td class="whitespace-nowrap">{format(r.codec, r.bits, r.sr)}</td>
            <td class="whitespace-nowrap">{size(r.bytes)}</td>
            <td>{r.n}</td>
            <td class="whitespace-nowrap">{Math.floor(r.dur / 60)} min</td>
            <td>
              {r.issues.map((i) => <span class="badge badge-issue">{i}</span>)}
              {r.agent?.verdict === "flag" && !r.agent.stale && <p class="mt-1 max-w-md text-xs text-chg-fg">{r.agent.message}</p>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>

<script>
  const q = document.querySelector<HTMLInputElement>("#q");
  const n = document.querySelector("#n");
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("#rows tr")];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-f]")];
  let filter = buttons.find((b) => b.getAttribute("aria-pressed") === "true")?.dataset["f"] ?? "all";

  function remember(push: boolean) {
    const url = new URL(location.href);
    const s = q?.value ?? "";
    if (filter === "all") url.searchParams.delete("f");
    else url.searchParams.set("f", filter);
    if (s) url.searchParams.set("q", s);
    else url.searchParams.delete("q");
    if (url.href === location.href) return;
    if (push) history.pushState(null, "", url);
    else history.replaceState(null, "", url);
  }

  function select(f: string) {
    filter = f;
    for (const x of buttons) x.setAttribute("aria-pressed", String(x.dataset["f"] === f));
  }

  function matches(r: HTMLTableRowElement, s: string): boolean {
    if (s && !r.dataset["q"]?.includes(s)) return false;
    if (filter === "all") return true;
    if (filter === "issues") return Number(r.dataset["issues"]) > 0;
    return r.dataset["state"] === filter;
  }

  function run() {
    const s = q?.value.toLowerCase() ?? "";
    let shown = 0;
    for (const r of rows) {
      r.hidden = !matches(r, s);
      if (!r.hidden) shown++;
    }
    if (n) n.textContent = `${shown} shown`;
  }

  q?.addEventListener("input", () => {
    run();
    remember(false);
  });
  for (const b of buttons) {
    b.addEventListener("click", () => {
      select(b.dataset["f"] ?? "all");
      run();
      remember(true);
    });
  }
  addEventListener("popstate", () => {
    const params = new URLSearchParams(location.search);
    if (q) q.value = params.get("q") ?? "";
    select(params.get("f") ?? "all");
    run();
  });
  run();
</script>
