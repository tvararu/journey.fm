---
import Pane from "@/app/Pane.astro";
---
<div id="queue" class="hidden w-[84px] flex-none data-[on]:lg:flex">
  <Pane label="queue" key="q" tag="nav" aria-label="Review queue" class="w-full">
    <div id="queue-items" class="flex min-h-0 flex-1 flex-col items-center gap-2.5 overflow-auto pt-4 pb-3"></div>
    <div class="flex flex-col items-center gap-0.5 pb-3 text-center text-[11px]">
      <span id="queue-pos" class="font-extrabold"></span>
      <span id="queue-state" class="text-muted"></span>
    </div>
  </Pane>
</div>
