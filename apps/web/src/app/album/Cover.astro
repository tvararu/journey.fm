---
import type { CoverCandidate, CoverChoice } from "@/lib/records";

type Props = { choice: CoverChoice; candidates: CoverCandidate[] };
const { choice, candidates } = Astro.props;
const fronts = candidates.filter((c) => c.types.includes("Front"));
const others = candidates.length - fronts.length;
---
<h2>Cover</h2>
<p>{choice.why}</p>
<p class="text-xs text-muted">
  master {choice.master} · embedded copy {choice.embed_size[0]}x{choice.embed_size[1]},
  {Math.floor(choice.embed_bytes / 1024)} KB
</p>
<div class="my-3 flex flex-wrap gap-4">
  {fronts.map((c) => {
    const pick = c.id === choice.chosen.id;
    return (
      <figure class={`w-40 ${pick ? "outline-3 outline-offset-3 outline-new-fg" : ""}`}>
        <a href={`/data/${c.path}`}>
          <img class="size-40 bg-faint object-cover" loading="lazy" src={`/data/${c.path}`} alt="" />
        </a>
        <figcaption class="mt-1 text-xs text-muted">
          {pick && <b class="text-new-fg">chosen<br /></b>}
          {c.source}<br />{c.width}x{c.height}, {Math.floor(c.bytes / 1024)} KB<br />{c.note}
        </figcaption>
      </figure>
    );
  })}
</div>
{others > 0 && <p class="text-muted">{others} other images archived (back, booklet, disc, tray).</p>}
