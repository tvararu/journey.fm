---
import type { CoverCandidate, CoverChoice } from "@/lib/records";
import { UPSCALERS } from "@/lib/upscale";

type Props = {
  cover: CoverChoice | undefined;
  candidates: CoverCandidate[];
  fallback: string | null;
  slug: string | undefined;
  album: string;
  back: string;
};
const { cover, candidates, fallback, slug, album, back } = Astro.props;
const fronts = candidates.filter((c) => c.types.includes("Front"));
const others = candidates.length - fronts.length;
const kb = (n: number) => `${Math.floor(n / 1024)} KB`;
const SHORT: Record<string, string> = {
  "Cover Art Archive (release)": "CAA release",
  "Cover Art Archive (release group)": "CAA release group",
  "Cover Art Archive (same catalogue number)": "CAA same cat. no.",
  "files (embedded)": "embedded in files",
  "files (folder)": "folder image",
};
const stem = (p: string) => (p.split("/").at(-1) ?? p).replace(/\.[^.]+$/, "");
const upscaledBy = (c: CoverCandidate) => /^Upscaled \((.+)\)$/.exec(c.source)?.[1];
const originals = fronts.filter((c) => !upscaledBy(c));
const parentOf = (c: CoverCandidate) => {
  const which = upscaledBy(c);
  const base = which ? stem(c.path).replace(`upscaled-${which}-`, "") : "";
  return originals.find((o) => stem(o.path) === base);
};
const groups = [
  ...originals.map((o) => ({ kids: fronts.filter((c) => parentOf(c) === o), lead: o as CoverCandidate | undefined })),
  ...fronts.filter((c) => upscaledBy(c) && !parentOf(c)).map((c) => ({ kids: [c], lead: undefined })),
];
const number = new Map(originals.map((o, i) => [o.id, i + 1]));
const upLabel = (c: CoverCandidate) => {
  const which = upscaledBy(c);
  return which && which in UPSCALERS ? UPSCALERS[which as keyof typeof UPSCALERS].label : which;
};
---
<h2 id="cover">Cover</h2>
<div class="flex flex-wrap items-start gap-6">
  {cover ? (
    <>
      <figure>
        <a href={`/data/${cover.master}`}><img class="size-72 bg-faint object-cover" src={`/data/${cover.master}`} alt="" /></a>
        <figcaption class="mt-2 text-xs text-muted">
          cover.jpg<br />
          {cover.chosen.width}x{cover.chosen.height}, {kb(cover.master_bytes)}<br />
          {cover.master_method}<br />
          from {cover.chosen.source}, {kb(cover.chosen.bytes)}
        </figcaption>
      </figure>
      <figure>
        <a href={`/data/${cover.embed}`}><img class="size-72 bg-faint object-cover" src={`/data/${cover.embed}`} alt="" /></a>
        <figcaption class="mt-2 text-xs text-muted">
          embedded<br />
          {cover.embed_size[0]}x{cover.embed_size[1]}, {kb(cover.embed_bytes)}
        </figcaption>
      </figure>
    </>
  ) : fallback ? (
    <img class="size-72 bg-faint object-cover" src={fallback} alt="" />
  ) : (
    <div class="size-72 bg-faint" />
  )}
  {fronts.length > 0 && (
    <div class="flex flex-wrap gap-4">
      {groups.map((g) => (
        <div class={`flex gap-3 ${g.kids.length ? "rounded border border-rule p-2" : ""}`}>
          {[...(g.lead ? [g.lead] : []), ...g.kids].map((c) => {
            const parent = parentOf(c);
            const n = number.get(c.id);
            return (
              <figure class="w-36">
                <div class="relative outline-offset-4 has-checked:outline-2 has-checked:outline-new-fg">
                  <a href={`/data/${c.path}`}><img class="size-36 bg-faint object-cover" loading="lazy" src={`/data/${c.path}`} alt="" /></a>
                  <span class="absolute top-1.5 left-1.5 rounded bg-black/60 px-1.5 text-xs text-white">{n ? `#${n}` : parent ? `#${number.get(parent.id)} ↑` : "↑"}</span>
                  {slug && (
                    <label
                      title="Use as master"
                      class="absolute top-1.5 right-1.5 flex size-6 cursor-pointer items-center justify-center rounded-full border border-white/60 bg-black/55 text-xs text-white/70 backdrop-blur-sm hover:bg-black/75 hover:text-white has-checked:w-auto has-checked:border-transparent has-checked:bg-new-fg has-checked:px-2 has-checked:font-bold has-checked:text-bg [&_.on]:hidden has-checked:[&_.on]:inline"
                    >
                      <input type="radio" name="cover" form="review" value={c.id} checked={c.id === cover?.chosen.id} class="sr-only" />
                      <svg viewBox="0 0 24 24" class="size-3 shrink-0" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg><span class="on ml-1 leading-none">master</span>
                    </label>
                  )}
                </div>
                {slug && !upscaledBy(c) && (
                  <form method="post" action="/api/upscale" class="upscale mt-2 flex gap-1 text-xs">
                    <input type="hidden" name="slug" value={slug} />
                    <input type="hidden" name="album" value={album} />
                    <input type="hidden" name="back" value={back} />
                    <input type="hidden" name="candidate" value={c.id} />
                    <select name="upscaler" class="min-w-0 flex-1 border border-rule bg-bg">
                      {Object.entries(UPSCALERS).map(([k, u]) => <option value={k}>{u.label}</option>)}
                    </select>
                    <button class="border border-rule bg-bg px-2">Upscale</button>
                  </form>
                )}
                <figcaption class="mt-1 text-xs text-muted">
                  {upscaledBy(c) ? (
                    <>{parent ? `#${number.get(parent.id)} ` : ""}upscaled with {upLabel(c)}<br />{c.width}x{c.height}, {kb(c.bytes)}</>
                  ) : (
                    <>{SHORT[c.source] ?? c.source}<br />{c.width}x{c.height}, {kb(c.bytes)}{c.note && <><br />{c.note}</>}</>
                  )}
                </figcaption>
              </figure>
            );
          })}
        </div>
      ))}
    </div>
  )}
</div>
{others > 0 && <p class="mt-2 text-xs text-muted">{others} more images archived</p>}

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("form.upscale")) {
    form.addEventListener("submit", () => {
      const button = form.querySelector("button");
      if (button) {
        button.disabled = true;
        button.textContent = "Upscaling…";
      }
    });
  }
</script>
